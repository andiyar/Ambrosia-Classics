NAME "Defend"; if hurt, run awayIF HealthLessThan(myself,Scratch) THEN	#100	Retreat(); make sure we are using a ranged weapon if availbeIF HasRangedWeapon(myself,5) THENIF NOT UsingRangedWeapon(myself, 5) THEN	#100	EquipRanged(5)			Continue(); pick a target if needed; start with last attackerIF NOT Exists(target) THENIF Exists(myself.LastAttacker) THEN	#100	SetTarget(myself.LastAttacker)IF NOT Exists(target) THEN	#100 	SetTarget(enemy.ByRange.Pick)			DoAttack(); if we are too close to the action - target this creature and back upIF InRange(enemy.ByRange.Best,3) THEN	#100	SetTarget(last)			RunAwayFrom(last,5); no enemy exists at this point...IF True() THEN	#100	FinishCombat()