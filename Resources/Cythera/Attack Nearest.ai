NAME "Attack Nearest"; If somebody else is attack me, 75% of the time attack themIF HasMeleeWeapon(myself) THENIF Exists(myself.LastAttacker) THENIF NOT IsTarget(myself.LastAttacker) THENIF InRange(myself.LastAttacker,2) THEN	#75		SetTarget(last)			DoAttack()	#25		Continue()IF Exists(enemy.ByRange.Pick) THEN	#100	SetTarget(last)			DoAttack(); no enemy exists at this point...IF True() THEN	#100	FinishCombat()