NAME "Healer"IF HasSpell(10) THEN ; Has healingIF HealthLessThan(ally.ByDamage.Best,Wounded) THEN#100	CastSpell(last,10); If we don't have the mana, don't waste on offensive spellsIF NOT ManaAtLeast(10) THEN#100	Pass(10); Try to frighten away the nastiesIF HasSpell(14) THEN ; Terrorisation#100	CastSpell(enemy.ByStrongest.Pick,14); Try to finish off the nearly deadIF HasSpell(18) THEN ; Mystic Arrow#100	CastSpell(enemy.ByDamage.Pick,18); no enemy exists at this point...IF True() THEN	#100	FinishCombat()