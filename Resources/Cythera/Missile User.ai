NAME "Missile Script"; Make sure we are using a ranged weaponIF NOT UsingRangedWeapon(myself,0) THENIF HasRangedWeapon(myself,0) THEN#100	EquipRanged(0)		Continue(); Out of ammo?  That defeats our entire purpose...IF OutOfAmmo() THEN		Retreat(); if the closest enemy is too close, try to run backIF InRange(enemy.ByRange.Best,3) THEN#100	RunAwayFrom(last,5); Switch target if our current target is more than 7 awayIF Exists(target) THENIF NOT InRange(target,7) THENIF InRange(enemy.ByRange.Best,4) THEN#100	SetTarget(last)		DoAttack(); Otherwise, try to close in on existing targetIF Exists(target) THENIF NOT InRange(target,7) THEN#100	RunToward(target,5)IF True() THEN#100	DoAttack()